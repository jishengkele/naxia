# Docker 部署配置（复制为 .env）
# Docker 镜像地址；参见 README 的部署说明。
# 本项目发布到 GitHub Container Registry（首次发布后可拉取）。
ARTEX_IMAGE=ghcr.io/jishengkele/naxia
ARTEX_TAG=latest
# 宿主机归档目录；容器只挂载该子目录。
ARTEX_ARCHIVE_HOST_DIR=/root/naxia-archives
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
